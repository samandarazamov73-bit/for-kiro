; Engine configuration file.
; Godot 4.7

config_version=5

[application]

config/name="Санаторий"
config/name.macos="Sanatorium"
config/description="Электроколяска от первого лица в полузаброшенном советском санатории"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode.macos="canvas_items"
window/stretch/aspect.macos="expand"

[gui]

theme/custom_font="res://assets/fonts/NotoSans.ttf"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
common/physics_jitter_fix=0.0

[rendering]

rendering_device/driver.macos="metal"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
occlusion_culling/use_occlusion_culling=true
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/atlas_size=4096
textures/default_filters/anisotropic_filtering_level=3
