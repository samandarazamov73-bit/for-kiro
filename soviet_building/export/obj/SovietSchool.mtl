# PBR extension keys (Pr/Pm/map_Pr/map_Pm/norm) are used by Blender, Unity and Unreal importers

newmtl M_Concrete_FacadePanel
Kd 1.0000 1.0000 1.0000
Ka 1 1 1
Ks 0.04 0.04 0.04
Ns 4.0
d 1.000
illum 2
Pr 1.000
Pm 1.000
map_Kd ../../textures/T_Concrete_FacadePanel_BaseColor.png
map_Pr ../../textures/T_Concrete_FacadePanel_Roughness.png
map_Ka ../../textures/T_Concrete_FacadePanel_AO.png
norm ../../textures/T_Concrete_FacadePanel_Normal.png
map_Bump -bm 1.00 ../../textures/T_Concrete_FacadePanel_Normal.png

